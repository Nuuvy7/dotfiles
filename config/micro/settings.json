  "colorscheme": "serpantinum",
  "mkparents": true,
  "savecursor": true,
  "saveundo": true,
  "scrollmargin": 3,
  "scrollspeed": 2,
  "mouse": true,
  "paste": true,
  "tabmovement": false,
  "softwrap": true,
  "wordwrap": true,
